/**
 * @fileoverview Firestore Security Rules for a user-centric recipe and meal planning application.
 *
 * Core Philosophy: This ruleset enforces a strict user-ownership model for personal data, while
 * enabling a collaborative, shared database for common resources like ingredients and global recipes.
 * It also grants administrators full access to manage platform data and users.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description User profile documents. Admins can list and read all profiles.
     * @path /users/{userId}
     */
    match /users/{userId} {
        allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
        allow list: if isAdmin();
        allow create: if isSignedIn() && isOwner(userId);
        allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
        allow delete: if isAdmin(); // Only admins can delete user documents directly
    }

    /**
     * @description Recipes owned by a specific user. Admins have full access.
     * @path /users/{userId}/recipes/{recipeId}
     */
    match /users/{userId}/recipes/{recipeId} {
      allow read, list: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update, delete: if isSignedIn() && (isExistingOwner(userId) || isAdmin());
    }

    /**
     * @description Weekly meal plan documents for a specific user. Admins have full access.
     * @path /users/{userId}/weekPlan/{day}
     */
    match /users/{userId}/weekPlan/{day} {
        allow read, list: if isSignedIn() && (isOwner(userId) || isAdmin());
        allow create: if isSignedIn() && isOwner(userId);
        allow update, delete: if isSignedIn() && (isExistingOwner(userId) || isAdmin());
    }

    /**
     * @description Archived week snapshots owned by a specific user. Admins have full access.
     * @path /users/{userId}/weekHistory/{snapshotId}
     */
    match /users/{userId}/weekHistory/{snapshotId} {
      allow read, list: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update, delete: if isSignedIn() && (isExistingOwner(userId) || isAdmin());
    }

    /**
     * @description Food diary: what the user actually ate each day, plus optional weigh-ins.
     * One document per calendar day (YYYY-MM-DD). Admins have full access.
     * @path /users/{userId}/diary/{dayId}
     */
    match /users/{userId}/diary/{dayId} {
      allow read, list: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update, delete: if isSignedIn() && (isExistingOwner(userId) || isAdmin());
    }

    /**
     * @description Ingredients owned by a specific user. Admins have full access.
     * @path /users/{userId}/ingredients/{ingredientId}
     */
    match /users/{userId}/ingredients/{ingredientId} {
      allow read, list: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update, delete: if isSignedIn() && (isExistingOwner(userId) || isAdmin());
    }

    /**
     * @description Global recipes managed by administrators.
     * @path /nutriplanner_recipes/{recipeId}
     */
    match /nutriplanner_recipes/{recipeId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isAdmin();
    }
    
    /**
     * @description Consulta por GRUPO de colección sobre todas las subcolecciones
     * `recipes` a la vez (`collectionGroup(firestore, 'recipes')`). La regla de
     * arriba solo cubre consultas ya acotadas a un `userId` conocido, así que sin
     * esta hasta un admin recibía `permission-denied` — confirmado en vivo.
     * Solo lectura y solo admin: la necesita el panel para saber en qué recetas
     * de usuarios se usa un ingrediente antes de borrarlo o fusionarlo.
     * @path /{path=**}/recipes/{recipeId}
     */
    match /{path=**}/recipes/{recipeId} {
      allow read, list: if isAdmin();
    }

    /**
     * @description Reportes que mandan los usuarios desde la app ("Contar un
     * problema"). Buzón de una sola dirección: cualquiera logueado deja el suyo
     * y **solo el admin los lee**, ni siquiera quien lo escribió — así nadie
     * puede listar los reportes de los demás.
     *
     * `uid` obligatorio y forzado al del autor: sin eso, alguien podría firmar
     * un reporte con el uid de otro. Sin edición ni borrado por el cliente:
     * un buzón donde el remitente puede borrar lo enviado no sirve de nada.
     * @path /feedback/{feedbackId}
     */
    match /feedback/{feedbackId} {
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 4000;
      allow read, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    /**
     * @description Shared, global ingredient database.
     * @path /ingredients/{ingredientId}
     */
    match /ingredients/{ingredientId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    //----------------------------------------------------------------------------------------------
    // Helper functions
    //----------------------------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Admin = custom claim `admin`, o el correo del superusuario como respaldo.
     *
     * ⚠️ Ese correo está escrito a mano AQUÍ, en `storage.rules` y en
     * `src/lib/constants.ts` (SUPERUSER_EMAIL): si se desincronizan, el boquete
     * es silencioso. Para quitarlo hay que hacerlo EN ESTE ORDEN, o te quedas
     * fuera de tu propio panel:
     *   1. Entrar en /admin/users y darse a uno mismo el rol de admin (eso
     *      escribe el custom claim vía `setUserAdmin`).
     *   2. Cerrar sesión y volver a entrar, para que el token traiga el claim.
     *   3. Comprobar que /admin sigue accesible.
     *   4. Solo entonces, borrar la comparación por correo de las dos reglas.
     */
    function isAdmin() {
      return isSignedIn() && (request.auth.token.admin == true || request.auth.token.email == 'jonicheik@gmail.com');
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && exists(/databases/$(database)/documents/users/$(userId));
    }
  }
}
