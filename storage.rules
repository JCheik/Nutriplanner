rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Recipe images live at recipes/<uid|global>/<recipeId>.<ext>.
    // They are uploaded directly from the client (signed-in user) via the
    // Firebase Storage SDK, so these rules are what actually authorize the write:
    // any authenticated user may upload an image under 5MB. Public read is
    // required to render the images. (Global recipes use ownerId "global";
    // writing the recipe doc itself is still admin-gated by Firestore rules.)
    match /recipes/{ownerId}/{imageName} {
      allow read;
      allow write: if request.auth != null &&
                      request.resource.contentType.matches('image/.*') &&
                      request.resource.size < 5 * 1024 * 1024;
    }

    // Deny everything else by default — no blanket public read.
    match /{allPaths=**} {
        allow read, write: if false;
    }
  }
}
